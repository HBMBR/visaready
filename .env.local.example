# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, local, ...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/visaready?sslmode=require"

# Public origin used in email links. Required in production: https://visaready.co
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Encrypts the signup details carried in the confirmation link.
# Generate with: openssl rand -base64 48
SIGNUP_TOKEN_SECRET=""

# SMTP (any provider). Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Must be a mailbox or alias on the SMTP server above. The welcome email is sent
# as "Darian from VisaReady" using this same address.
SMTP_FROM="VisaReady <hello@visaready.co>"

# Staff who can sign in to the signups dashboard at /admin (comma-separated).
# Removing an address revokes access immediately.
ADMIN_EMAILS="marketing@visaready.co, support@visaready.co"

# Ad tracking (optional). Pixels load only after a visitor accepts cookies;
# with neither set, no cookie banner is shown. Redeploy after changing.
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
