// VisaReady — database schema
// Run: `npx prisma migrate dev --name init` after configuring DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A row exists ONLY for people who clicked the link in their verification
// email. Unconfirmed signups are never stored — their details travel inside the
// encrypted link (see lib/signup-token.ts) until it is clicked.
model Signup {
  id                String    @id @default(cuid())
  firstName         String    @db.VarChar(60)
  lastName          String    @db.VarChar(60)
  email             String    @unique @db.VarChar(255)
  phone             String?   @db.VarChar(40) // optional since Nov 2026
  nationality       String    @db.VarChar(8) // ISO 3166-1 alpha-2, or "OTHER"
  desiredRole       String    @db.VarChar(80)
  destination       String?   @db.VarChar(16) // lib/destinations.ts; null for rows created before it was asked

  // When the email link was clicked (= when this row was created)
  verifiedAt        DateTime  @default(now())

  // Sign-up order, assigned at verification. Staff-only: never shown to members.
  founderNumber     Int?      @unique

  // Referrals: everyone gets a personal code (visaready.co/?ref=CODE).
  // The app always sets it; the database default covers older code that
  // doesn't (e.g. production while a preview has migrated a shared database).
  referralCode      String    @unique @default(dbgenerated("upper(substr(md5((random())::text || (clock_timestamp())::text), 1, 10))")) @db.VarChar(16)
  referredById      String?
  referredBy        Signup?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         Signup[]  @relation("Referrals")
  // false when the referral looks like a self-referral (see lib/referral.ts)
  referralCounted   Boolean   @default(false)

  // Agreement to the Terms, Privacy Policy and Disclaimer (the tick box on the
  // sign-up form). When they ticked it and sent the form, and which version
  // (lib/legal.ts). Empty for people who joined before the box existed.
  termsAgreedAt     DateTime?
  termsVersion      String?   @db.VarChar(32)

  // Set when the member clicks "unsubscribe" in an email
  unsubscribedAt    DateTime?

  // Audit (captured at the verification click)
  ipAddress         String?   @db.VarChar(64)
  userAgent         String?   @db.VarChar(500)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([verifiedAt])
  @@index([createdAt])
  @@index([referredById])
}
