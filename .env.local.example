# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, local, ...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/visaready?sslmode=require"

# Public origin used in email links. Required in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Encrypts the signup details carried in the confirmation link.
# Generate with: openssl rand -base64 48
SIGNUP_TOKEN_SECRET=""

# SMTP (any provider). Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VisaReady <noreply@visaready.co>"

# Staff who can sign in to the signups dashboard at /admin (comma-separated).
# Removing an address revokes access immediately.
ADMIN_EMAILS="marketing@visaready.co, support@visaready.co"
